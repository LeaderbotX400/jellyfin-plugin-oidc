<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Jellyfin 12 only. The 12.0 server retargeted to .NET 10 and its NuGet packages
      ship a net10.0 dependency group only, so this build cannot load on Jellyfin
      10.11 — that server line stays on plugin 0.3.3, the last release that supports it.
      The targetAbi in
      build.yaml/meta.json is what keeps Jellyfin's installer from offering this
      build to a 10.x server.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.OIDC</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.OIDC</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      1.x is the Jellyfin 12 line; 0.3.3 was the last Jellyfin 10.11 release. Note the
      release workflow overrides this with -p:Version=$(tag).0, so the tag is the source of
      truth for a published build and this value only matters for local/manual builds.
    -->
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Static analysis: enable built-in NetAnalyzers at the recommended rule set -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Treat nullable warnings as hard errors; all CS86xx must be fixed, not suppressed -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <NoWarn>
      $(NoWarn);
      <!-- CA1848: LoggerMessage delegates — performance micro-opt out of scope for a plugin this size (~35 call sites) -->
      CA1848;
      <!-- CA1873: Expensive logger argument evaluation — same family as CA1848; suppressed together -->
      CA1873;
      <!-- CA1707: logout_token parameter underscore — required by OIDC back-channel logout spec (RFC 9457 / OIDC Session) -->
      CA1707
    </NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.OIDC.Tests" />
    <InternalsVisibleTo Include="Jellyfin.Plugin.OIDC.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="IdentityModel" Version="7.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\oidcrbac.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
